rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Hardened Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rfrifatbs@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.efootballId is string && data.efootballId.size() <= 50 &&
             data.role in ['player', 'admin'];
    }

    // Validation for Tournament
    function isValidTournament(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.format in ['knockout', 'league', 'single_elimination', 'round_robin', 'group_knockout'] &&
             data.status in ['upcoming', 'ongoing', 'completed'];
    }

    // Validation for Match Fixture
    function isValidMatchFixture(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.tournamentId is string && data.tournamentId.size() <= 128 &&
             data.status in ['scheduled', 'submitted', 'approved', 'rejected'];
    }

    // Validation for Announcement
    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.type in ['urgent', 'tournament', 'maintenance', 'info'] &&
             data.active is bool;
    }

    // Test connection doc (Required by Firebase skill)
    match /test/connection {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list, write: if isAdmin();
    }

    // Users Collection (Synced across devices)
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Tournaments Collection (Public real-time sync)
    match /tournaments/{tournamentId} {
      allow get, list: if true;
      allow create, update: if isValidId(tournamentId) && isValidTournament(incoming());
      allow delete: if isValidId(tournamentId);
    }

    // Fixtures Collection (Public real-time match schedules and verified scores)
    match /fixtures/{fixtureId} {
      allow get, list: if true;
      allow create, update: if isValidId(fixtureId) && isValidMatchFixture(incoming());
      allow delete: if isValidId(fixtureId);
    }

    // Announcements Collection (Real-time urgent notice feed)
    match /announcements/{announcementId} {
      allow get, list, read: if true;
      allow create, update, delete, write: if true;
    }

    // App Settings Collection
    match /settings/{settingId} {
      allow get, list, read, write: if true;
    }

    // Wallet Transactions Collection (Deposits, withdrawals, balance adjustments)
    match /wallet_transactions/{txId} {
      allow get, list: if true;
      allow create, update: if isValidId(txId);
      allow delete: if isValidId(txId);
    }
  }
}
